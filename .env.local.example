# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 (test_ck_*, test_sk_* prefix for sandbox)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_
TOSS_SECRET_KEY=test_sk_
# Webhook signing secret (Toss dashboard → Webhook → 시크릿 키)
TOSS_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Distributed rate limiting (OPTIONAL). When BOTH are set, all rate limiters use
# Upstash Redis (durable across Vercel instances); otherwise they fall back to a
# per-instance in-memory limiter. Provision via Vercel Marketplace → Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Photos OAuth (OPTIONAL — env overrides admin DB settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron auth — Bearer token Vercel Cron sends to /api/cron/* (set in Vercel envs)
CRON_SECRET=
